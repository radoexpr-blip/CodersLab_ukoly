      <column caption='Selected metric' datatype='real' default-format='c&quot;€&quot;#,##0.00' name='[Calculation_0918931236962304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;wage&quot; THEN [wage]&#13;&#10;WHEN &quot;value&quot; THEN [value]&#13;&#10;WHEN &quot;release_clause&quot; THEN [release_clause]&#13;&#10;END' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_1196008577839104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;MAX&quot; THEN MAX([value])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;MIN&quot; THEN MIN([value])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;AVG&quot; THEN AVG([value])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;MEDIAN&quot; THEN MEDIAN([value])&#13;&#10;END' />
      </column>
      <column caption='Dynamic Player Value' datatype='real' name='[Calculation_1378527787212800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;MAX&apos; THEN MAX([value])&#13;&#10;WHEN &apos;MIN&apos; THEN MIN([value])&#13;&#10;WHEN &apos;AVG&apos; THEN AVG([value])&#13;&#10;WHEN &apos;MEDIAN&apos; THEN MEDIAN([value])&#13;&#10;END' />
      </column>
      <column caption='Wage &amp; Overall Cluster' datatype='string' name='[Calculation_1378527853608962]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [wage] &lt;= 5000 AND [overall] &lt;= 65 THEN &quot;1 – Nízký plat, nízký overall&quot;&#13;&#10;ELSEIF [wage] &lt;= 15000 AND [overall] &lt;= 75 THEN &quot;2 – Střední plat, střední overall&quot;&#13;&#10;ELSEIF [wage] &lt;= 50000 THEN &quot;3 – Vysoký plat, dobrý overall&quot;&#13;&#10;ELSE &quot;4 – Top hvězdy&quot;&#13;&#10;END' />
      </column>
